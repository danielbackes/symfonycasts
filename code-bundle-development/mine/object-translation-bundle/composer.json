{
  "name": "almtcasts/object-translation-bundle",
  "description": "Translate your entities!",
  "type": "symfony-bundle",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "AlmtCasts\\ObjectTranslationBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AlmtCasts\\ObjectTranslationBundle\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Daniel Backes",
      "email": "danielbackes@proton.me"
    }
  ],
  "require": {
    "symfony/framework-bundle": "^7.4",
    "symfony/translation": "^7.4",
    "doctrine/doctrine-bundle": "^2.19",
    "doctrine/orm": "^3.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "symfony/phpunit-bridge": "^8.1"
  }
}
