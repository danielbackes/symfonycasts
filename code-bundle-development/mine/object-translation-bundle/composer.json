{
  "name": "almtcasts/object-translation-bundle",
  "description": "Translate your entities!",
  "type": "symfony-bundle",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "AlmtCasts\\ObjectTranslationBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AlmtCasts\\ObjectTranslationBundle\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Daniel Backes",
      "email": "danielbackes@proton.me"
    }
  ],
  "require": {
    "php": ">=8.2",
    "symfony/framework-bundle": "^6.4|^7.4",
    "symfony/translation": "^6.4|^7.4",
    "doctrine/doctrine-bundle": "^2.19",
    "doctrine/orm": "^3.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "symfony/phpunit-bridge": "^8.1",
    "zenstruck/foundry": "^2.13",
    "php-cs-fixer/shim": "^3.95"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
